{
  "info": {
    "name": "Huellitas Cafeteras API",
    "description": "Colección de endpoints para probar la API de Huellitas Cafeteras en Producción (Railway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/health",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usuario@example.com\",\n  \"contrasena\": \"Password123!\",\n  \"nombre\": \"Juan Pérez\"\n}"
            },
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/auth/registro",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "auth", "registro"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usuario@example.com\",\n  \"contrasena\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/auth/login",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Obtener Usuario Actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "Reemplaza {{token}} con el JWT del login"
              }
            ],
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/auth/me",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Ubicaciones",
      "item": [
        {
          "name": "Obtener Departamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/ubicaciones/departamentos",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "ubicaciones", "departamentos"]
            }
          }
        }
      ]
    },
    {
      "name": "Casos",
      "item": [
        {
          "name": "Crear Caso (Autenticado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "Reemplaza {{token}} con el JWT del login"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Gato extraviado\",\n  \"descripcion\": \"Gato negro extraviado en el barrio Centro\",\n  \"ubicacion\": \"Calle 10 #5-20\"\n}"
            },
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/casos",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "casos"]
            }
          }
        },
        {
          "name": "Obtener Feed de Casos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://huellitas-cafeteras-production.up.railway.app/v1/casos/feed",
              "protocol": "https",
              "host": ["huellitas-cafeteras-production", "up", "railway", "app"],
              "path": ["v1", "casos", "feed"]
            }
          }
        }
      ]
    }
  ]
}
