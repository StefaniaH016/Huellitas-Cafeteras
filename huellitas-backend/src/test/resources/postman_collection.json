              "raw": "{\n  \"nombre\": \"Ciudadano Voluntario\",\n  \"correo\": \"{{user_correo}}\",\n  \"contrasena\": \"{{user_contrasena}}\",\n  \"telefono\": \"3101234567\",\n  \"rol\": \"CIUDADANO_VOLUNTARIO\",\n  \"barrioId\": 1\n}"
