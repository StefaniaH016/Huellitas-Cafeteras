{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/huellitas-frontend/browser",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|svg|woff|woff2|ttf|eot|map))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
